# Manzana40 - Production Environment Variables
# Copy this file to .env and fill in the values

# ==========================================
# DATABASE (Supabase PostgreSQL)
# ==========================================
# Get this from Supabase Dashboard → Settings → Database → Connection String
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require"

# ==========================================
# NEXTAUTH AUTHENTICATION
# ==========================================
# Generate a secure secret:
# openssl rand -base64 32 (on Mac/Linux)
# or visit: https://generate-secret.vercel.app/32
NEXTAUTH_SECRET="your-generated-secret-here"
NEXTAUTH_URL="https://manzana40.com"

# ==========================================
# PUBLIC URLS
# ==========================================
NEXT_PUBLIC_BASE_URL="https://manzana40.com"
NEXT_PUBLIC_SITE_URL="https://manzana40.com"

# ==========================================
# ADMIN CREDENTIALS
# ==========================================
# These are used to login to /admin
ADMIN_EMAIL="admin@manzana40.com"
ADMIN_PASSWORD="your-secure-admin-password"
